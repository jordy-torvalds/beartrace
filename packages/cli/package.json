{
  "name": "@beartrace/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "beartrace": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "node dist/cli.js validate --root ../..",
    "validate:examples": "node dist/cli.js validate --root ../../examples",
    "build:projection": "node dist/cli.js build-projection --root ../.. --config ../../config/beartrace.config.json --out ../../dist/projection.json",
    "build:projection:examples": "node dist/cli.js build-projection --root ../../examples --config ../../config/beartrace.config.json --as-of 2025-06-01 --out ../../dist/projection.examples.json"
  },
  "dependencies": {
    "@beartrace/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
